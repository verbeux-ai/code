{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Verboo",
  "description": "__MSG_appDesc__",
  "key": "",
  "version": "0.3.1",
  "version_name": "0.3.1",
  "default_locale": "en",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "options_ui": {
    "page": "src/panel/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/routines/recording/inject.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "identity",
    "nativeMessaging",
    "notifications",
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "__MSG_openSidePanel__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
